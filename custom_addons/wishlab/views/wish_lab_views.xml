<odoo>
    <record id="wish_lab_view_list" model="ir.ui.view">
        <field name="name">wish.lab.list</field>
        <field name="model">wish.lab</field>
        <field name="arch" type="xml">
            <list string="Employees">
                <field name="name"/>
                <field name="email"/>
                <field name="connection_date"/>
                <field name="birthday"/>
            </list>
        </field>
    </record>

    <record id="wish_lab_action" model="ir.actions.act_window">
        <field name="name">WishLabAction</field>
        <field name="res_model">wish.lab</field>
        <field name="view_mode">list</field>
    </record>
</odoo>